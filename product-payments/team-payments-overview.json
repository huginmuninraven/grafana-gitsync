{
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "expr": "sum(kube_pod_status_phase{product=\"payments\", phase=\"Running\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Running pods",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "expr": "sum(increase(kube_pod_container_status_restarts_total{product=\"payments\"}[1h]))",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Container restarts (1h)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "targets": [
        {
          "expr": "count by (product) (kube_pod_info)",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Visible products (no product filter: Team LBAC decides)",
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "id": 4,
      "targets": [
        {
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{product=\"payments\", container!=\"\"}[5m]))",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "title": "CPU by pod",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "id": 5,
      "targets": [
        {
          "expr": "sum by (service_name) (rate(traces_span_metrics_calls_total{product=\"payments\", span_kind=\"SPAN_KIND_SERVER\"}[5m]))",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }
      ],
      "title": "Request rate by service",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "id": 6,
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{product=\"payments\"}",
          "refId": "A"
        }
      ],
      "title": "Recent payments logs",
      "type": "logs"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": [
    "team-access",
    "payments"
  ],
  "templating": {
    "list": [
      {
        "label": "Metrics",
        "name": "prom",
        "query": "prometheus",
        "regex": "/^LBAC .* Mimir$/",
        "type": "datasource"
      },
      {
        "label": "Logs",
        "name": "loki",
        "query": "loki",
        "regex": "/^LBAC .* Loki$/",
        "type": "datasource"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "title": "Payments team overview",
  "uid": "team-payments-overview"
}
