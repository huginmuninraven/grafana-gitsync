                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{product=\"payments\", container!=\"\"}[5m]))",
                        "legendFormat": "{{pod}}"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
