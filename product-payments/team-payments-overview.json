                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "count by (product) (kube_pod_info)",
                        "format": "table",
                        "instant": true
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "",
          "id": 3,
          "links": [],
          "title": "Visible products (no product filter: Team LBAC decides)",
          "vizConfig": {
            "group": "table",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "custom": {
                    "align": "auto",
                    "cellOptions": {
                      "type": "auto"
